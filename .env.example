# Copy these into Render -> Environment (never commit real keys to GitHub)
GROQ_API_KEY=your-groq-key
QDRANT_URL=https://your-cluster.cloud.qdrant.io
QDRANT_API_KEY=your-qdrant-key
SYNC_SECRET=choose-a-long-random-password

# Optional (these are the defaults)
STORE_URL=https://www.clover.pk
PRODUCT_COLLECTION=clover_products
GROQ_MODEL=openai/gpt-oss-20b
MIN_SCORE=0.25
# Add http://localhost:5500 here while testing from your own computer
ALLOWED_ORIGINS=https://www.clover.pk,https://clover.pk
